# ─── App ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=true

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./awaaz.db
# For Postgres: DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/awaaz

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# ─── Storage ────────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
MODELS_CACHE_DIR=./models_cache

# ─── Device ─────────────────────────────────────────────────────────────────
DEVICE=auto   # auto | cpu | cuda

# ─── Models ─────────────────────────────────────────────────────────────────
WHISPER_MODEL=small
IMAGE_CAPTION_MODEL=microsoft/Florence-2-base
TRANSLATION_EN_UR_MODEL=Helsinki-NLP/opus-mt-en-ur
TRANSLATION_UR_EN_MODEL=Helsinki-NLP/opus-mt-ur-en

# ─── OCR ─────────────────────────────────────────────────────────────────────
# Path to the Tesseract executable.  Leave blank to use the auto-detected
# default (Windows: C:\Program Files\Tesseract-OCR\tesseract.exe; Linux: tesseract)
TESSERACT_CMD=

# ─── TTS ─────────────────────────────────────────────────────────────────────
TTS_EN_ENGINE=piper       # piper | kokoro
TTS_UR_ENGINE=mms         # mms | edge_tts
ENABLE_EDGE_TTS=false
PIPER_VOICE=en_US-lessac-medium
AUDIO_MAX_CHARS=8000

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

AUDIO_MAX_CHARS=40000